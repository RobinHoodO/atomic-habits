{
  "name": "atomic-habits",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atomic-habits"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Run next to Neon (Frankfurt): every page makes many DB round trips.
  // Brute-force guard for sign-in (lib/auth.ts), keyed by email.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1"
  }
}
